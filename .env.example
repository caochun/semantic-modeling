# GLM_API_URL 支持 API base URL 或完整 /chat/completions 地址。
GLM_API_URL=https://open.bigmodel.cn/api/paas/v4
GLM_API_KEY=replace-with-your-key
GLM_MODEL=glm-5.3
GLM_REASONING_EFFORT=high
GLM_API_TIMEOUT_MS=180000
# 0 lets the provider choose its output limit; set a positive value for a proxy limit.
GLM_MAX_OUTPUT_TOKENS=0
GLM_DNS_RESULT_ORDER=ipv4first

# 以下均可省略；相对路径以启动目录为基准。
SEMANTIC_DOC_DIR=rawdoc
SEMANTIC_DATA_DIR=.semantic
# 老式 .doc 在 macOS 上先使用 textutil；空结果时可使用以下 LibreOffice。
# SEMANTIC_SOFFICE_PATH=/path/to/soffice
